@using Opc.Ua
@implements IDisposable
@inject UaBrowserService Browser
@inject BrowserState State
@inject IJSRuntime Js

<div class="panel attributes-panel @(_collapsed ? "collapsed" : "")">
    <div class="panel-header">
        <span>Attributes</span>
        <span class="header-controls">
            <button class="mini" title="Refresh" @onclick="RefreshAsync" disabled="@(State.SelectedNode is null)">⟳</button>
            <button class="mini" title="@(_collapsed ? "Expand" : "Collapse")" @onclick="ToggleCollapsedAsync">@(_collapsed ? "▸" : "▾")</button>
        </span>
    </div>
    @if (!_collapsed)
    {
        <div class="panel-body">
            @if (State.SelectedNode is null)
            {
                <div class="hint">Select a node to inspect its attributes.</div>
            }
            else if (_loading)
            {
                <div class="hint">Loading @State.SelectedNode.DisplayName …</div>
            }
            else
            {
                <table class="grid">
                    <thead>
                        <tr><th>Attribute</th><th>Value</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr class="@(row.IsBad ? "bad" : "")">
                                <td class="attr-name">@row.Name</td>
                                <td class="attr-value">
                                    <div class="value-text">@row.Value</div>
                                    @if (!string.IsNullOrEmpty(row.Detail))
                                    {
                                        <div class="value-detail">@row.Detail</div>
                                    }
                                </td>
                                <td class="row-actions">
                                    <button class="mini" title="Copy value" @onclick="() => CopyAsync(row.Value)">⧉</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {
    private List<UaAttributeRow> _rows = [];
    private bool _loading;
    private NodeId? _loadedFor;
    private bool _collapsed;

    private async Task ToggleCollapsedAsync()
    {
        _collapsed = !_collapsed;

        try
        {
            await Js.InvokeVoidAsync("druopc.setPanelCollapsed", "right.attributes", _collapsed);
        }
        catch (Exception)
        {
            // localStorage unavailable; not critical.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _collapsed = await Js.InvokeAsync<bool>("druopc.getPanelCollapsed", "right.attributes");
            if (_collapsed)
            {
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // localStorage unavailable; not critical.
        }
    }

    protected override void OnInitialized()
    {
        State.SelectionChanged += OnSelectionChanged;
    }

    private void OnSelectionChanged()
        => _ = InvokeAsync(async () =>
        {
            if (State.SelectedNode?.NodeId != _loadedFor)
            {
                await RefreshAsync();
            }
        });

    private async Task RefreshAsync()
    {
        var node = State.SelectedNode;
        if (node is null)
        {
            _rows = [];
            _loadedFor = null;
            StateHasChanged();
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            _rows = await Browser.ReadAttributesAsync(node.NodeId);
            _loadedFor = node.NodeId;
        }
        catch (Exception ex)
        {
            _rows = [];
            State.Notify($"Reading attributes failed: {ex.Message}", isError: true);
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await Js.InvokeAsync<bool>("druopc.copyText", text);
            State.Notify("Copied value");
        }
        catch (Exception)
        {
            State.Notify("Could not access the clipboard", isError: true);
        }
    }

    public void Dispose()
    {
        State.SelectionChanged -= OnSelectionChanged;
    }
}
