@using System.Text
@implements IDisposable
@inject UaEventLog EventLog
@inject BrowserState State
@inject IJSRuntime Js

<div class="panel events-panel">
    <div class="panel-header">
        <span>
            Events
            @if (EventLog.IsActive)
            {
                <span class="live-badge" title="Subscribed to @EventLog.NotifierName">● @EventLog.NotifierName</span>
            }
            <span class="count-badge">@EventLog.Events.Count</span>
        </span>
        <span class="header-controls">
            <label title="Only receive events at or above this severity">
                sev
                <select value="@EventLog.MinSeverity" @onchange="OnSeverityFilterChanged">
                    <option value="0">all</option>
                    <option value="200">≥ 200</option>
                    <option value="400">≥ 400</option>
                    <option value="700">≥ 700</option>
                </select>
            </label>
            <label title="Only receive events of this type">
                type
                <select value="@_eventTypeFilter" @onchange="OnTypeFilterChanged">
                    <option value="all">all</option>
                    <option value="conditions">conditions</option>
                    <option value="system">system</option>
                </select>
            </label>
            <button class="mini" title="Export as CSV" @onclick="ExportCsvAsync" disabled="@(EventLog.Events.Count == 0)">⭳ csv</button>
            <button class="mini" title="Clear received events" @onclick="() => EventLog.Clear()">🗑</button>
            <button class="mini" title="Stop event subscription" @onclick="StopAsync" disabled="@(!EventLog.IsActive)">⏹</button>
        </span>
    </div>
    <div class="panel-body">
        @if (!EventLog.IsActive && EventLog.Events.Count == 0)
        {
            <div class="hint">Click ⚡ on an object in the tree (e.g. Server) to receive its events.</div>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr><th>Time</th><th>Severity</th><th>Source</th><th>Type</th><th>Message</th></tr>
                </thead>
                <tbody>
                    <Virtualize Items="@((ICollection<UaEventRow>)EventLog.Events)" Context="e" ItemSize="24">
                        <tr>
                            <td class="mono dim">@e.Time</td>
                            <td class="sev sev-@SeverityBucket(e.Severity)">@e.Severity</td>
                            <td>@e.SourceName</td>
                            <td>@e.EventType</td>
                            <td>@e.Message</td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        EventLog.Changed += OnChanged;
    }

    private void OnChanged()
        => _ = InvokeAsync(StateHasChanged);

    private static string SeverityBucket(string severity)
        => int.TryParse(severity, out int value)
            ? value >= 700 ? "high" : value >= 400 ? "mid" : "low"
            : "low";

    private string _eventTypeFilter = "all";

    private async Task OnSeverityFilterChanged(ChangeEventArgs e)
    {
        try
        {
            await EventLog.SetFilterAsync(int.Parse((string)e.Value!), EventLog.EventTypeFilter);
        }
        catch (Exception ex)
        {
            State.Notify($"Could not apply the event filter: {ex.Message}", isError: true);
        }
    }

    private async Task OnTypeFilterChanged(ChangeEventArgs e)
    {
        _eventTypeFilter = (string)e.Value!;
        Opc.Ua.NodeId? typeId = _eventTypeFilter switch
        {
            "conditions" => Opc.Ua.ObjectTypeIds.ConditionType,
            "system" => Opc.Ua.ObjectTypeIds.SystemEventType,
            _ => null,
        };

        try
        {
            await EventLog.SetFilterAsync(EventLog.MinSeverity, typeId);
        }
        catch (Exception ex)
        {
            State.Notify($"Could not apply the event filter: {ex.Message}", isError: true);
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await EventLog.StopAsync();
        }
        catch (Exception ex)
        {
            State.Notify($"Could not stop the event subscription: {ex.Message}", isError: true);
        }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder("ReceivedUtc,Time,Severity,Source,EventType,Message\n");
        foreach (var e in EventLog.Events)
        {
            sb.AppendLine(string.Join(',',
                Csv(e.ReceivedUtc.ToString("o")), Csv(e.Time), Csv(e.Severity),
                Csv(e.SourceName), Csv(e.EventType), Csv(e.Message)));
        }

        await Js.InvokeVoidAsync("uascope.downloadFile",
            $"uascope-events-{DateTime.Now:yyyyMMdd-HHmmss}.csv", "text/csv", sb.ToString());
    }

    private static string Csv(string value)
        => value.Contains(',') || value.Contains('"') || value.Contains('\n')
            ? $"\"{value.Replace("\"", "\"\"")}\""
            : value;

    public void Dispose()
    {
        EventLog.Changed -= OnChanged;
    }
}
