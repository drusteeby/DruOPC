<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opcplc</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>DruOPC.Simulator</PackageId>
    <Authors>Dru Steeby and contributors</Authors>
    <Version>1.0.0</Version>
    <RootNamespace>OpcPlc</RootNamespace>
    <UserSecretsId>bdf7b209-fef3-44d4-9aba-17035fda5efd</UserSecretsId>
    <LangVersion>Preview</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DruOPC Simulator</Title>
    <Product>DruOPC</Product>
    <Description>OPC UA server that behaves like a PLC: simulated values, anomalies, boilers, events, alarms, methods and user-defined nodes. Part of the DruOPC toolkit; based on Azure-Samples/iot-edge-opc-plc.</Description>
    <RepositoryUrl>https://github.com/drusteeby/DruOPC</RepositoryUrl>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <!-- CA1873 fires on long-standing logging call sites; not worth the churn to fix. -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ContainerRepository>druopc/simulator</ContainerRepository>
    <ContainerUser>root</ContainerUser>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-azurelinux3.0-distroless</ContainerBaseImage>
  </PropertyGroup>
  <ItemGroup>
    <ContainerEnvironmentVariable Include="APP_UID" Value="" />
    <ContainerEnvironmentVariable Include="DOTNET_ReadyToRun" Value="0" />
    <ContainerEnvironmentVariable Include="DOTNET_TieredPGO" Value="1" />
    <ContainerEnvironmentVariable Include="DOTNET_TC_QuickJitForLoops" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
	<PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.91" />
  </ItemGroup>

  <!-- When referencing a local build of the OPC UA stack for testing, define the constant UseLocalOpcUaSdk in the file Directory.Build.targets -->
  <Choose>
    <When Condition="'$(Configuration)'=='Debug'">
      <ItemGroup Condition="!$(DefineConstants.Contains(UseLocalOpcUaSdk))">
        <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration.Debug" Version="1.5.376.244" NoWarn="NU5104" />
        <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server.Debug" Version="1.5.376.244" NoWarn="NU5104" />
      </ItemGroup>
      <ItemGroup Condition="$(DefineConstants.Contains(UseLocalOpcUaSdk))">
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Security.Certificates\Opc.Ua.Security.Certificates.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Server\Opc.Ua.Server.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Stack\Opc.Ua.Core\Opc.Ua.Core.csproj" />
      </ItemGroup>
    </When>
    <When Condition="'$(Configuration)'=='Release'">
      <ItemGroup Condition="!$(DefineConstants.Contains(UseLocalOpcUaSdk))">
        <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.376.244" NoWarn="NU5104" />
        <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.376.244" NoWarn="NU5104" />
      </ItemGroup>
      <ItemGroup Condition="$(DefineConstants.Contains(UseLocalOpcUaSdk))">
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Security.Certificates\Opc.Ua.Security.Certificates.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Libraries\Opc.Ua.Server\Opc.Ua.Server.csproj" />
        <ProjectReference Include="..\..\UA-.NETStandard\Stack\Opc.Ua.Core\Opc.Ua.Core.csproj" />
      </ItemGroup>
    </When>
  </Choose>

  <ItemGroup>
    <!-- Compiled information models, embedded so no filesystem layout is assumed at runtime.
         LogicalName is the resource name the loaders pass to LoadFromBinaryResource. -->
    <EmbeddedResource Include="Boilers\Boiler1\BoilerModel1.PredefinedNodes.uanodes" LogicalName="BoilerModel1" />
    <EmbeddedResource Include="Boilers\Boiler2\BoilerModel2.PredefinedNodes.uanodes" LogicalName="BoilerModel2" />
    <EmbeddedResource Include="CompanionSpecs\DI\Opc.Ua.DI.PredefinedNodes.uanodes" LogicalName="OpcUaDi" />
    <EmbeddedResource Include="SimpleEvent\SimpleEvents.PredefinedNodes.uanodes" LogicalName="SimpleEvents" />
    <None Update="nodesfile.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="opcplc.service">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="DruOPC.Simulator.targets" PackagePath="build/DruOPC.Simulator.targets" />
    <Content Include="Boilers/**/*.*">
      <PackagePath>contentFiles\Boilers</PackagePath>
    </Content>
    <Content Include="CompanionSpecs/**/*.*">
      <PackagePath>contentFiles\CompanionSpecs</PackagePath>
    </Content>
    <Content Include="SimpleEvent/**/*.*">
      <PackagePath>contentFiles\SimpleEvent</PackagePath>
    </Content>
    <None Remove="appsettings.json" />
    <Content Include="nodesfile.json">
      <PackagePath>contentFiles</PackagePath>
    </Content>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
